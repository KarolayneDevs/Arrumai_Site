# -----------------------------------------------------------------------------
# EXEMPLO DE CONFIGURAÇÃO DO BACKEND
# -----------------------------------------------------------------------------
# Copie este arquivo para .env e ajuste os valores do ambiente do seu MySQL.
# Enquanto o Banco não estiver configurado, a API segue usando o armazenamento
# em memória para permitir a base funcional de testes.
# -----------------------------------------------------------------------------

PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=arrumai

# Conta administrativa criada ao iniciar a API.
ADMIN_EMAIL=admin@arrumai.com
ADMIN_PASSWORD=Admin@123456

# Gmail: use uma senha de app, nunca a senha normal da conta.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-do-gmail
SMTP_FROM=Arrumaí <seu-email@gmail.com>
